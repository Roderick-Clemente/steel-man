+    # A dry run that reads zero existing rows means the merge guard is
+    # pointed at the wrong file — the silent half of finding 6.5.
+    #
+    # Parse the integer; do NOT substring-match a rendered sentence. The
+    # original form of this assertion looked for "0 existing rows" while
+    # reconstruct-telemetry.py:183 prints "Existing rows: {n}", so the
+    # literal could never appear and the assertion could never fire —
+    # including in the exact partial-fix scenario it was written to catch.
+    # A dead assertion that reads as protection is worse than no assertion:
+    # it is the silent-green shape §7 forbids, inside the judge that exists
+    # to enforce §7. Builder finding F2, upheld; also found by kimi-k3.
+    if not os.path.isfile(os.path.join(REPO_ROOT, _SOR_REL)):
+        pytest.skip(
+            f"no {_SOR_REL} in this tree, so a zero row count is legitimate; "
+            "the SoR is gitignored and absent on a fresh clone (spec §4.7 errata)"
+        )
+    match = re.search(r"Existing rows:\s*(\d+)", proc.stdout)
+    assert match is not None, (
+        "no 'Existing rows: N' line in the dry-run output, so the judge cannot "
+        "confirm the merge guard read the real SoR; if the script's output format "
+        f"changed, retarget this assertion rather than deleting it\nstdout:\n{proc.stdout}"
     )
+    assert int(match.group(1)) > 0, (
+        f"dry run read {match.group(1)} existing rows while {_SOR_REL} exists on "
