#!/usr/bin/env bash
# run-sprint — per-pilot one-command firing of the adversarial-sprint runner.
#
# This is the per-pilot overlay wrapper. To use:
#   1. Copy templates/overlay/*.template.json into <PILOT_REPO>/.adversarial-sprint/
#      and edit the placeholders to the pilot's actual paths.
#   2. Symlink or copy this file into <PILOT_REPO>/.adversarial-sprint/bin/run-sprint
#      and make it executable (`chmod +x bin/run-sprint`).
#   3. Run from the pilot repo:  ./bin/run-sprint                 # full live run
#                                  ./bin/run-sprint --dry-run     # first time
#
# Per pass-r3 H-3 (chunk-13 fix): this wrapper accepts ALL flag
# configurations in the documented form, with no positional
# `chunks-file` requirement. argv is scanned for `--chunks-file`,
# and the runner is fired with the resolved chunks-file (default:
# $OVERLAY_DIR/chunks.json). Setting in the OVERLAY_DIR takes
# precedence; `$1` (positional) is no longer required or supported.

set -eo pipefail  # NOTE: removed -u so unset env vars don't crash the
                  # signing-key warning (H-3b fix).

# Resolve this script's location. The .adversarial-sprint dir is
# one directory up; the PILOT_REPO is one further up.
SCRIPT_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
OVERLAY_DIR="$(dirname "$SCRIPT_DIR")"
PILOT_REPO="$(dirname "$OVERLAY_DIR")"

# Find the overlay's config; refuse if missing.
CONFIG="$OVERLAY_DIR/sprint-loop-config.json"
if [ ! -f "$CONFIG" ]; then
  echo "FATAL: per-pilot config not found at $CONFIG" >&2
  echo "       See templates/overlay/README.md for the install recipe." >&2
  exit 2
fi

# Walk argv, find any --chunks-file (in either form) and capture its
# value; pass everything else through to the runner.
CHUNKS_FILE=""
runner_argv=()
i=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --chunks-file)
      shift
      CHUNKS_FILE="${1:-}"
      if [ -z "$CHUNKS_FILE" ]; then
        echo "FATAL: --chunks-file expected a path; saw empty" >&2
        exit 2
      fi
      ;;
    --chunks-file=*)
      CHUNKS_FILE="${1#--chunks-file=}"
      ;;
    *)
      runner_argv+=("$1")
      ;;
  esac
  shift || true
done

# Default chunks file: the overlay's chunks.json (or legacy *.example.json).
if [ -z "$CHUNKS_FILE" ]; then
  for try in "$OVERLAY_DIR/chunks.json" "$OVERLAY_DIR/chunks.example.json" "$OVERLAY_DIR/chunks-example.json"; do
    if [ -f "$try" ]; then
      CHUNKS_FILE="$try"
      break
    fi
  done
fi

if [ -z "$CHUNKS_FILE" ] || [ ! -f "$CHUNKS_FILE" ]; then
  echo "FATAL: chunks file not found. Pass --chunks-file <path>, or copy chunks.json into $OVERLAY_DIR/." >&2
  exit 2
fi

# Find the framework checkout from the pilot's config.
FRAMEWORK_ROOT="$(python3 -c "import json; print(json.load(open('$CONFIG'))['framework_root'])")"

if [ ! -d "$FRAMEWORK_ROOT/tools" ]; then
  echo "FATAL: framework_root in $CONFIG is $FRAMEWORK_ROOT, but no tools/ subdir found." >&2
  echo "       Did you edit the placeholders in the template?" >&2
  exit 2
fi

RUNNER="$FRAMEWORK_ROOT/tools/sprint-loop.py"
if [ ! -f "$RUNNER" ]; then
  echo "FATAL: runner not found at $RUNNER" >&2
  exit 2
fi

echo "[run-sprint] pilot:        $PILOT_REPO"
echo "[run-sprint] framework:    $FRAMEWORK_ROOT"
echo "[run-sprint] overlay:      $OVERLAY_DIR"
echo "[run-sprint] config:       $CONFIG"
echo "[run-sprint] chunks-file:  $CHUNKS_FILE"
# Pass-r3 H-3b fix: set -u was crashing here when the operator
# hadn't set EVIDENCE_SIGNING_KEY. Use ${EVIDENCE_SIGNING_KEY:-}
# explicitly so an unset value doesn't trigger 'unbound variable'.
if [ "${EVIDENCE_SIGNING_KEY:-}" = "" ]; then
  echo "[run-sprint] WARN: EVIDENCE_SIGNING_KEY is unset; live mode will refuse per §7 (chunk-10 F-10)." >&2
fi

# Stdin reserved for the human reconciliation gate per §6 / §15 Act 2.
# When stdin is closed (CI / unattended), pass --non-interactive or --unattended.
exec python3 "$RUNNER" \
  --config "$CONFIG" \
  --chunks-file "$CHUNKS_FILE" \
  --pilot-root "$PILOT_REPO" \
  "${runner_argv[@]}"
